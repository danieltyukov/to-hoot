{
  "name": "to-hoot",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/apps-script", "apps/mcp", "apps/worker"],
  "scripts": {
    "build": "npm run build -w @to-hoot/core && npm run build -w @to-hoot/ui",
    "test": "vitest run",
    "test:e2e": "npm run e2e -w @to-hoot/ui",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
