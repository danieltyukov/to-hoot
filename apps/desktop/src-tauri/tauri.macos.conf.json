{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToHoot",
  "mainBinaryName": "ToHoot",
  "identifier": "com.tohoot.desktop",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ToHoot",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 },
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
