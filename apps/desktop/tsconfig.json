{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [],
    // apps/desktop is deliberately not an npm workspace, so the Tauri CLI sees
    // a flat node_modules. Core is a type-only import here, resolved by path
    // rather than by a package link.
    "paths": { "@to-hoot/core": ["../../packages/core/src/index.ts"] }
  },
  "include": ["src/**/*.ts"]
}
