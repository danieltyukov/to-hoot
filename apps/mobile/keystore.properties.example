# Copy to apps/mobile/android/keystore.properties and fill in. That file is
# gitignored, as is any *.jks or *.keystore anywhere in the repository.
#
# Environment variables win over this file, which is what CI uses:
# KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD.
storeFile=/absolute/path/to/to-hoot-release.jks
storePassword=
keyAlias=to-hoot
keyPassword=
